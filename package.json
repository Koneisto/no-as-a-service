{
  "name": "no-as-service",
  "version": "1.0.1",
  "description": "A lightweight API that returns random rejection or no reasons.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "noaas-mcp": "./build/mcp-server.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node src/index.js",
    "test": "echo \"No tests defined\" && exit 0",
    "mcp:build": "tsc && chmod +x build/mcp-server.js",
    "mcp:dev": "npm run mcp:build && node build/mcp-server.js",
    "worker:dev": "wrangler dev --config deployment/wrangler.toml",
    "worker:deploy": "wrangler deploy --config deployment/wrangler.toml",
    "worker:tail": "wrangler tail --config deployment/wrangler.toml",
    "worker:kv:upload": "wrangler kv key put --binding=REASONS_KV reasons \"$(cat data/reasons.json)\" --config deployment/wrangler.toml --remote",
    "docker:build": "docker build -f deployment/Dockerfile -t noaas .",
    "docker:up": "docker-compose -f deployment/docker-compose.yml up -d",
    "docker:down": "docker-compose -f deployment/docker-compose.yml down"
  },
  "author": "hotheadhacker",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.50.0"
  },
  "engines": {
    "node": ">=18"
  }
}
