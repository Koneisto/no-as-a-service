name = "noaas"
main = "../src/worker.js"
compatibility_date = "2024-01-01"
compatibility_flags = ["nodejs_compat"]

# Account ID - Replace with your Cloudflare account ID
# Find it at: https://dash.cloudflare.com/ (in the URL or right sidebar)
# account_id = "your-account-id-here"

# Workers KV Namespaces
# Create these namespaces with:
# npx wrangler kv:namespace create "REASONS_KV" --config deployment/wrangler.toml
# npx wrangler kv:namespace create "RATE_LIMIT_KV" --config deployment/wrangler.toml
[[kv_namespaces]]
binding = "REASONS_KV"
id = "your-reasons-kv-namespace-id"

[[kv_namespaces]]
binding = "RATE_LIMIT_KV"
id = "your-rate-limit-kv-namespace-id"

# Routes (optional - for custom domains)
# [[routes]]
# pattern = "noaas.yourdomain.com/*"
# zone_name = "yourdomain.com"

# Environment variables (optional)
[vars]
ENVIRONMENT = "production"

# Usage model - "bundled" for free tier (100k requests/day)
# usage_model = "bundled"

# Limits (only available on paid plans)
# [limits]
# cpu_ms = 50  # Max CPU time per request
